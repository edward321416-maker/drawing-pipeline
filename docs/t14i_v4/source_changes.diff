+        lab = yl[round(y, 2)] if round(y, 2) in yl else str(len(ys) - ys.index(y))
+        sh.line(Xl - 1.0, Y(y), Xl - 14.5, Y(y), 0.1, "#888", "6,1.4,1,1.4")
