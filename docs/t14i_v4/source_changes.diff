+    S["prog"] = dict(az=AZ_OUT, el=26.0, width_px=1500, explode={"gap": 8.0}, layers=[ex(L_SLAB), ex(L_ROOF), ex(L_ZONES), ex(L_CORES), ex(L_TUBES), ex(L_ESC), ex(L_SPR)])
