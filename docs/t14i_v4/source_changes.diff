+            return T
+        for n, c in ((np.array([1.0, 0, 0]), x0), (np.array([-1.0, 0, 0]), -x1), (np.array([0, 1.0, 0]), y0), (np.array([0, -1.0, 0]), -y1)):
+            T = bv._clip_half(T, n, c)
+            if len(T) == 0:
+                break
+        return T
+    return f
