+def place_blocks(sh, blocks, rect, ncols=1, gap=6.0, name="panel", pt_note=None):
+    """블록들을 직사각형 rect=(x0,y0,x1,y1)의 ncols 단에 위에서 아래로 채운다. 넘치면 LayoutConflict. 채운 영역을 claim한다."""
