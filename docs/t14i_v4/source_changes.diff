+def _pdf_image(path, dpi=120):
+    import pymupdf
+    d = pymupdf.open(path)
+    pm = d[0].get_pixmap(dpi=dpi, alpha=False)
+    return Image.frombytes("RGB", (pm.width, pm.height), pm.samples)
