+    def __init__(self, ox, oy, cx, cy, scale):
+        self.k = 1000.0 / scale
+        self.scale = scale
+        self.ox, self.oy, self.cx, self.cy = ox, oy, cx, cy      # (ox,oy) = sheet point of model point (cx,cy)
