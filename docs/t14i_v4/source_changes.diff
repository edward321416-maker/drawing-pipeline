+    page.draw_rect(R(x, y, x + w, y + 5.2), color=color, fill=(1, 1, 1), width=0.3 * MM, overlay=True)
+    add_text(page, (x + 1, y + 0.6, x + w - 1, y + 5.0), text, 6, True, color, 1)
