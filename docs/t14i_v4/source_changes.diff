+def break_line(sh, x0, y0, x1, y1, color="#222"):
+    """Zig-zag break (cut-off) line between two sheet points."""
+    dx, dy = x1 - x0, y1 - y0
+    L = math.hypot(dx, dy)
+    ux, uy = dx / L, dy / L
+    nx, ny = -uy, ux
+    n = max(int(L / 3.0), 2)
+    pts = [(x0, y0)]
+    for i in range(1, n):
+        t = i / n
+        off = 1.1 if i % 2 else -1.1
+        pts.append((x0 + dx * t + nx * off, y0 + dy * t + ny * off))
+    pts.append((x1, y1))
+    dline(sh, pts, color, 0.25)
