+def _view(ctx, key):
+    specs = view_specs(ctx.run, ctx.model)
+    p = view_path(ctx.cache, key, specs[key])
+    if not os.path.exists(p):
+        ensure_views(ctx.run, [key], procs=1, model=ctx.model)
+    return Image.open(p).convert("RGB")
+
