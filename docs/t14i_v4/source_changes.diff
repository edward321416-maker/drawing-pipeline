+    # ── 점유 도형(시트 mm) ────────────────────────────────────────────────────────────────────────
+    occ_parts = load_occupancy(chk, cuts)
+    occ_model = unary_union([g.buffer(BUF[k]) for k, g in occ_parts.items()])
+    occ = affine_transform(occ_model, fr.matrix)
+    placed = []                                                   # 이미 놓은 기호·선(시트 mm)
+
+    def free(fp, pad=0.0):
