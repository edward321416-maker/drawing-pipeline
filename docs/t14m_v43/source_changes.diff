+    matrix = fitz.Matrix(dpi / 72, dpi / 72)
+    paths: list[Path] = []
+    for page_number in range(3, 7):
+        target = output / f"report_{page_number:02d}_pilot_{dpi}dpi.png"
+        document[page_number - 1].get_pixmap(matrix=matrix, alpha=False).save(target)
+        paths.append(target)
+    document.close()
+    return paths
