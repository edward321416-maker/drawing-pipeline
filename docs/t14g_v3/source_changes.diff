diff --git a/tools/t14g/furniture_qa.py b/tools/t14g/furniture_qa.py
new file mode 100644
index 0000000..f70500c
--- /dev/null
+++ b/tools/t14g/furniture_qa.py
@@ -0,0 +1,128 @@
+"""Independent furniture / circulation QA on real geometry.
+
+Furniture geometry comes from the exported typed list (raw_plan_<F>_check.json -> furniture_v3); the structure it must not touch
+(columns, tube shells, cores) and the slab come straight from the model slices (raw_slices), NOT from the layout engine.
+
+  collisions     furniture pairs overlapping > 0.01 m2 (intended stacking, e.g. media wall on the stage, excluded)
+  structure      furniture touching a column / tube shell / core wall (hard) and within 0.2 m (soft)
+  repetition     share of the most common identical footprint among furniture units (chairs/stools/plants excluded)
+  diversity      number of distinct furniture types among the units
+  aisle          widest clear aisle such that every tube anchor stays connected, by erosion of the free floor (not the engine's own router)
+  distinct       Jaccard similarity of the furniture type sets between floors (layouts must differ by program)
+"""
+import json
+import math
+import os
+import sys
+from collections import Counter
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(os.path.dirname(HERE))
+sys.path.insert(0, os.path.join(ROOT, "src"))
+import pipeline_common as pc  # noqa: E402
+import book_views as bv  # noqa: E402
+from shapely import wkt  # noqa: E402
+from shapely.geometry import Point, Polygon  # noqa: E402
+from shapely.ops import unary_union  # noqa: E402
+
+ACCESSORY = {"chair", "terrace_chair", "stool", "shrub", "tree", "popup_mark"}
+INTENDED_STACK = {frozenset(("stage", "media_wall"))}
+MAX_SHARE, MIN_TYPES = 0.35, 5
+
+
+def _shell(g):
+    ps = [p for p in (g.geoms if hasattr(g, "geoms") else [g]) if p.geom_type == "Polygon"]
+    return Polygon(max(ps, key=lambda p: p.area).exterior)
+
+
+def structure(run, floor):
+    sl = pc.load_slice(os.path.join(run, "raw_slices"), floor)
+    cuts = pc.cut_geometries(sl)
+    slab = bv._union([pc.polygons_from_segments(p["segments"]) for p in sl["projection"]])
+    cols = unary_union([g for _, g in cuts.get("column", [])]) if cuts.get("column") else Polygon()
+    tubes = [(it["name_ko"], _shell(g)) for it, g in cuts.get("tube_wall", [])]
+    cores = unary_union([g for _, g in cuts.get("core_wall", [])]) if cuts.get("core_wall") else Polygon()
+    return slab, cols, tubes, cores
+
+
+def check_floor(run, floor):
+    chk = json.load(open(os.path.join(run, "plans", "_raw", "raw_plan_%s_check.json" % floor), encoding="utf-8"))
+    items = [(i["type"], i["kind"], wkt.loads(i["wkt"])) for i in chk["furniture_v3"]]
+    bodies = [(t, g) for t, k, g in items if k in ("body", "counter")]
+    slab, cols, tubes, cores = structure(run, floor)
+    res = {"floor": floor, "programs": [m["program"] for m in chk.get("layout_meta", [])], "units": 0}
+    pairs = 0
+    for i in range(len(bodies)):
+        for j in range(i + 1, len(bodies)):
+            if bodies[i][1].intersects(bodies[j][1]) and frozenset((bodies[i][0], bodies[j][0])) not in INTENDED_STACK:
+                if bodies[i][1].intersection(bodies[j][1]).area > 0.01:
+                    pairs += 1
+    res["overlapping_pairs"] = pairs
+    tube_u = unary_union([s for _, s in tubes]) if tubes else Polygon()
+    hard = unary_union([g for g in (cols, tube_u, cores) if not g.is_empty])
+    res["touching_structure"] = sum(1 for _, g in bodies if g.intersects(hard))
+    res["within_0.2m_of_structure"] = sum(1 for _, g in bodies if g.distance(hard) < 0.2)
+    res["outside_slab"] = sum(1 for _, g in bodies if not slab.buffer(0.05).contains(g))
+    units = [(t, g) for t, g in bodies if t not in ACCESSORY]
+    res["units"] = len(units)
+    sig = Counter((t, round(g.bounds[2] - g.bounds[0], 1), round(g.bounds[3] - g.bounds[1], 1)) for t, g in units)
+    top, n = sig.most_common(1)[0]
+    res["max_identical_share"] = round(n / len(units), 3)
+    res["most_repeated"] = list(top)
+    res["types"] = sorted({t.split("_")[0] if t.startswith(("brand_cell", "street_island", "cashier")) else t for t, _ in units})
+    res["n_types"] = len(res["types"])
+    # aisle width by erosion of the free floor
+    free = slab.buffer(-0.3).difference(unary_union([hard.buffer(0.2)] + [g.buffer(0.1) for _, g in bodies]))
+    ctr = slab.centroid
+    anchors = []
+    for name, sh in tubes:
+        if "캡슐" in name or sh.area < 8.0:
+            continue
+        c = sh.centroid
+        d = math.hypot(ctr.x - c.x, ctr.y - c.y) or 1.0
+        r = math.sqrt(sh.area / math.pi)
+        anchors.append(Point(c.x + (ctr.x - c.x) / d * (r + 1.8), c.y + (ctr.y - c.y) / d * (r + 1.8)))
+    res["aisle_anchors"] = len(anchors)
+    best = None
+    struct_free = slab.buffer(-0.3).difference(hard.buffer(0.2))
+    for r in (1.2, 1.0, 0.9, 0.75, 0.6, 0.45):
+        es = struct_free.buffer(-r)
+        big = max((p for p in (es.geoms if hasattr(es, "geoms") else [es]) if p.geom_type == "Polygon"), key=lambda p: p.area, default=None)
+        valid = [a for a in anchors if big is not None and big.distance(a) < 1.3]       # 구조만으로도 이 폭이 닿는 앵커(튜브 사이 좁은 틈은 가구 탓이 아니다)
+        er = free.buffer(-r)
+        comps = [p for p in (er.geoms if hasattr(er, "geoms") else [er]) if p.geom_type == "Polygon" and not p.is_empty]
+        near = {i for i, p in enumerate(comps) for a in valid if p.distance(a) < 1.3}
+        if len(valid) >= 2 and comps and len(near) == 1 and all(any(p.distance(a) < 1.3 for p in comps) for a in valid):
+            best = 2 * r
+            res["aisle_anchors_reachable_by_structure"] = len(valid)
+            break
+    res["aisle_width_connecting_all_anchors_m"] = best
+    res["passes"] = bool(pairs == 0 and res["touching_structure"] == 0 and res["max_identical_share"] <= MAX_SHARE and res["n_types"] >= MIN_TYPES
+                         and best is not None and best >= 1.2)
+    return res
+
+
+def check_distinct(results):
+    sets = {r["floor"]: set(r["types"]) for r in results}
+    prim = {r["floor"]: (r["programs"] or [""])[0] for r in results}
+    out, worst = {}, 0.0
+    fl = sorted(sets)
+    for i, a in enumerate(fl):
+        for b in fl[i + 1:]:
+            if prim[a] == prim[b]:                                                     # 같은 프로그램(10F·15F F&B)은 비슷해야 한다. 서로 다른 프로그램만 비교한다
+                continue
+            j = len(sets[a] & sets[b]) / max(1, len(sets[a] | sets[b]))
+            out["%s~%s" % (a, b)] = round(j, 2)
+            worst = max(worst, j)
+    return {"jaccard": out, "max_jaccard": round(worst, 2), "passes": worst <= 0.5}
+
+
+if __name__ == "__main__":
+    run = os.path.abspath(sys.argv[1])
+    rs = [check_floor(run, f) for f in ("3F", "8F", "10F", "13F", "15F")]
+    d = check_distinct(rs)
+    json.dump({"floors": rs, "distinct": d}, open(sys.argv[2], "w", encoding="utf-8"), ensure_ascii=False, indent=1)
+    for r in rs:
+        print(r["floor"], "units", r["units"], "types", r["n_types"], "share", r["max_identical_share"], "overlap", r["overlapping_pairs"], "touch", r["touching_structure"],
+              "soft<0.2m", r["within_0.2m_of_structure"], "aisle", r["aisle_width_connecting_all_anchors_m"], "PASS" if r["passes"] else "FAIL")
+    print("distinct:", d["max_jaccard"], "PASS" if d["passes"] else "FAIL")
diff --git a/tools/t14g/make_coverage.py b/tools/t14g/make_coverage.py
new file mode 100644
index 0000000..533dd52
--- /dev/null
+++ b/tools/t14g/make_coverage.py
@@ -0,0 +1,156 @@
+"""A-902 층별 구성 일람(B2~15F 17개 층) + typical_floor_coverage.json.
+
+모든 층의 평면을 따로 그리지 않고(사용자 지시: 기준층만), 17개 층 전부의 슬래브·프로그램 구역·튜브·코어·기둥·개구를 모델 slice에서
+같은 축척(1:1000)으로 작게 그린다. 9F·14F는 8F·13F와 다른 부분(수직동선 개구)을 붉게 칠해 차이를 보인다.
+수치는 전부 slice 폴리곤에서 계산한다(숫자를 직접 쓰지 않는다).
+"""
+import csv
+import json
+import math
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TOOLS = os.path.dirname(HERE)
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, os.path.join(ROOT, "src"))
+sys.path.insert(0, TOOLS)
+import pipeline_common as pc  # noqa: E402
+import book_views as bv  # noqa: E402
+from shapely.geometry import Polygon  # noqa: E402
+from shapely.ops import unary_union  # noqa: E402
+import t14d_sheet as _ts  # noqa: E402
+from t14g import config as cfg  # noqa: E402
+cfg.apply(_ts)
+from t14d_sheet import Sheet, geom_rings  # noqa: E402
+from t14e_make_details import hatch, poly_mm  # noqa: E402
+
+ORDER = ["B2", "B1"] + ["%dF" % i for i in range(1, 16)]
+K = 1.0                                     # 1:1000 → 모델 1 m = 1 mm
+CELL_W, CELL_H = 66.0, 80.0
+X0, Y0 = 12.0, 12.0
+STYLE = {"판매": (None, None, "#bbb"), "F&B": (45.0, 1.7, "#777"), "문화": (135.0, 1.7, "#777"), "garden": (90.0, 1.3, "#5a7"), "서비스": (0.0, 1.2, "#999")}
+
+
+def _slab(sl):
+    return bv._union([pc.polygons_from_segments(p["segments"]) for p in sl["projection"]])
+
+
+def _holes(g):
+    out = []
+    for p in (g.geoms if hasattr(g, "geoms") else [g]):
+        if p.geom_type == "Polygon":
+            out += [Polygon(r) for r in p.interiors]
+    return out
+
+
+def floor_facts(run, f, ffl):
+    sl = pc.load_slice(os.path.join(run, "raw_slices"), f)
+    slab = _slab(sl)
+    cuts = pc.cut_geometries(sl)
+    zones = {}
+    for z in sl["zones"]:
+        g = pc.polygons_from_segments(z["segments"])
+        zones[z["name_ko"]] = zones.get(z["name_ko"], 0.0) + g.area
+    holes = _holes(slab)
+    return {"floor": f, "ffl_m": round(ffl, 3), "slab_area_m2": round(slab.area, 1), "program_areas_m2": {k: round(v, 1) for k, v in zones.items()},
+            "openings": {"count": len(holes), "area_m2": round(sum(h.area for h in holes), 1)},
+            "tubes": len(cuts.get("tube_wall", [])), "cores": len(cuts.get("core_wall", [])), "columns": len(cuts.get("column", [])),
+            "_slab": slab, "_sl": sl, "_cuts": cuts}
+
+
+def build(run, out_base):
+    ev = json.load(open(os.path.join(run, "00_index", "floor_equivalence_evidence.json"), encoding="utf-8"))
+    floors_z = ev["floor_z_m"]
+    ffl0 = floors_z["1F"]
+    plans = json.load(open(os.path.join(run, "plans", "plan_sheets.json"), encoding="utf-8"))
+    plan_of = {}
+    for p in plans:
+        for m in p["applies_to"]:
+            plan_of[m] = (p["sheet"], "OWN_PLAN" if m == p["floor"] else "SHARED_PLAN_WITH_DELTA", p["floor"])
+    group_of = {f: g for g in ev["groups"] for f in g["floors"]}
+    facts = {f: floor_facts(run, f, floors_z[f] - ffl0) for f in ORDER}
+    ref_of = {"9F": "8F", "14F": "13F"}
+    gb = unary_union([facts[f]["_slab"] for f in ORDER]).bounds                 # 모든 층이 같은 중심·같은 틀(건물 전체 범위)
+
+    sh = Sheet("A-902", "층별 구성 일람 — B2~15F 17개 층 (프로그램·개구·수직동선 차이)", 1000, "MODEL_DATA · LEVEL S · 가구 없음",
+               subtitle="전 층을 같은 축척(1:1000)으로 비교 · 슬래브·프로그램 구역·튜브·코어·기둥·개구는 모델 slice에서 계산 · 붉은색 = 기준층 대비 다른 부분",
+               extra_lines=["평면을 따로 발행한 층: 3F(P-101) · 8F+9F(P-102) · 10F(P-103) · 13F+14F(P-104) · 15F(P-105) · 1F(A-003). 나머지는 이 일람에서 확인",
+                            "구역 해칭: 판매 = 무늬 없음 · F&B = 45° 사선 · 문화·엔터 = 135° 사선 · 정원 = 세로선 · 서비스 = 가는 가로선"])
+    cov = []
+    for i, f in enumerate(ORDER):
+        col, row = i % 6, i // 6
+        ox, oy = X0 + col * CELL_W, Y0 + row * CELL_H
+        fa = facts[f]
+        slab, sl, cuts = fa["_slab"], fa["_sl"], fa["_cuts"]
+        cx, cy = (gb[0] + gb[2]) / 2, (gb[1] + gb[3]) / 2
+        X = lambda x, ox=ox, cx=cx: ox + CELL_W / 2 + (x - cx) * K
+        Y = lambda y, oy=oy, cy=cy: oy + 6.0 + 28.0 + (cy - y) * K
+        sh.claim("cell_" + f, ox + 1.0, oy, ox + CELL_W - 1.0, oy + CELL_H - 1.0)
+        sh.text(ox + 3.0, oy + 4.0, f, 8, "bold", "#111")
+        sh.text(ox + 16.0, oy + 4.0, "FFL %+.3f" % fa["ffl_m"], 6, "normal", "#555")
+        sh.path([[(X(x), Y(y)) for x, y in r] for r in geom_rings(slab)], fill="#f6f6f6", stroke="#555", w=0.15)
+        for z in sl["zones"]:
+            g = pc.polygons_from_segments(z["segments"])
+            ang, sp, colr = STYLE.get(z["name_ko"], (None, None, "#bbb"))
+            if ang is not None:
+                hatch(sh, poly_mm(g, X, Y), spacing=sp, angle=ang, w=0.07, color=colr)
+            sh.path([[(X(x), Y(y)) for x, y in r] for r in geom_rings(g)], stroke="#999", w=0.08)
+        if f in ref_of:                                                       # 기준층 대비 차이(수직동선 개구)
+            ref = facts[ref_of[f]]["_slab"]
+            diff = slab.symmetric_difference(ref)
+            fa["delta_vs_reference"] = {"reference": ref_of[f], "slab_symdiff_m2": round(diff.area, 1), "pieces": len([p for p in (diff.geoms if hasattr(diff, "geoms") else [diff]) if p.area > 0.5])}
+            for p in (diff.geoms if hasattr(diff, "geoms") else [diff]):
+                if p.geom_type == "Polygon" and p.area > 0.5:
+                    sh.path([[(X(x), Y(y)) for x, y in r] for r in geom_rings(p)], fill="#c33", stroke="#a00", w=0.15, opacity=0.55)
+        for kind, fill, w in (("core_wall", "#333", 0.1), ("tube_wall", "#fff", 0.12), ("column", "#000", 0.05)):
+            for it, g in cuts.get(kind, []):
+                sh.path([[(X(x), Y(y)) for x, y in r] for r in geom_rings(g)], fill=fill, stroke="#111", w=w)
+        for h in _holes(slab):
+            sh.path([[(X(x), Y(y)) for x, y in h.exterior.coords]], stroke="#c77", w=0.1, dash="1.2,0.8")
+        prog = " · ".join("%s %s㎡" % (k, format(int(round(v)), ",")) for k, v in fa["program_areas_m2"].items())
+        sh.text(ox + 3.0, oy + 68.0, prog[:46], 5.5, "normal", "#333")
+        ps = plan_of.get(f, ("A-003", "OWN_PLAN", "1F") if f == "1F" else (None, "OVERVIEW_ONLY", None))
+        sh.text(ox + 3.0, oy + 72.0, "개구 %d개 %s㎡ · 슬래브 %s㎡" % (fa["openings"]["count"], format(int(round(fa["openings"]["area_m2"])), ","), format(int(round(fa["slab_area_m2"])), ",")), 5.5, "normal", "#555")
+        tag = {"OWN_PLAN": "평면: %s" % ps[0], "SHARED_PLAN_WITH_DELTA": "평면: %s(공통) · %s 대비 차이 붉게" % (ps[0], ref_of.get(f, "")), "OVERVIEW_ONLY": "이 일람으로 확인(별도 평면 없음)"}[ps[1]]
+        sh.text(ox + 3.0, oy + 76.0, tag, 5.5, "bold", "#a33" if ps[1] == "OVERVIEW_ONLY" else "#06a")
+        g_ = group_of.get(f, {})
+        entry = {k: v for k, v in fa.items() if not k.startswith("_")}
+        entry.update({"plan_sheet": ps[0], "publication_status": ps[1], "equivalence_group": g_.get("id"), "equivalence_kind": g_.get("kind"), "also_in": "A-902"})
+        cov.append(entry)
+    # 18번째 칸: 범례·방위·스케일
+    ox, oy = X0 + 5 * CELL_W, Y0 + 2 * CELL_H
+    sh.claim("legend", ox + 1.0, oy, ox + CELL_W - 1.0, oy + CELL_H - 1.0)
+    sh.text(ox + 3.0, oy + 5.0, "범례", 8, "bold", "#111")
+    items = [("판매", "무늬 없음"), ("F&B", "45° 사선"), ("문화", "135° 사선"), ("garden", "세로선"), ("서비스", "가는 가로선")]
+    for j, (k, t) in enumerate(items):
+        yy = oy + 11.0 + j * 5.2
+        ang, sp, colr = STYLE[k]
+        if ang is not None:
+            hatch(sh, [Polygon([(ox + 3, yy - 3), (ox + 12, yy - 3), (ox + 12, yy + 1), (ox + 3, yy + 1)])], spacing=1.0, angle=ang, w=0.07, color=colr)
+        sh.path([[(ox + 3, yy - 3), (ox + 12, yy - 3), (ox + 12, yy + 1), (ox + 3, yy + 1)]], stroke="#999", w=0.1)
+        sh.text(ox + 14, yy, "%s (%s)" % (k, t), 5.5, "normal", "#333")
+    sh.path([[(ox + 3, oy + 38), (ox + 12, oy + 38), (ox + 12, oy + 42), (ox + 3, oy + 42)]], fill="#c33", stroke="#a00", w=0.15, opacity=0.55)
+    sh.text(ox + 14, oy + 41.2, "기준층과 다른 부분", 5.5, "normal", "#333")
+    sh.text(ox + 3, oy + 47, "점선 = 슬래브 개구(수직동선)", 5.5, "normal", "#333")
+    sh.text(ox + 3, oy + 52, "검정 사각 = 코어 · 흰 원 = 튜브 · 점 = 기둥", 5.5, "normal", "#333")
+    nd = 63.2
+    try:
+        nd = json.load(open(os.path.join(run, "elevations", "elevation_registry.json"), encoding="utf-8"))["frame"]["north_deg"]
+    except (OSError, KeyError):
+        pass
+    sh.north_arrow(ox + 12, oy + 66, nd, r=4.0)
+    sh.scale_bar(ox + 28, oy + 67.0, meters=(0, 10, 20))
+    sh.title_block()
+    os.makedirs(os.path.dirname(out_base), exist_ok=True)
+    sh.save(out_base, allow=(("legend", "scale_bar"),))
+    cov_path = os.path.join(os.path.dirname(out_base), "typical_floor_coverage.json")
+    json.dump({"scale": "1:1000", "sheet": "A-902", "floors": cov,
+               "note": "B2~15F 17개 층 모두 A-902에 그려진다. 별도 평면이 없는 층은 publication_status=OVERVIEW_ONLY. STRICT 동등 쌍 0건(증거: floor_equivalence_evidence.json)이라 층을 합치지 않았다."},
+              open(cov_path, "w", encoding="utf-8"), ensure_ascii=False, indent=1)
+    return out_base + ".pdf", cov_path, cov
+
+
+if __name__ == "__main__":
+    run = os.path.abspath(sys.argv[1])
+    print(build(run, os.path.join(run, "appendix", "A-902_floor_overview"))[:2])
