+    cs.save(os.path.join(out, "Candidate_V3_contact_sheet.png"), optimize=True)
+
+    # ── QA reports ────────────────────────────────────────────────────────────────────────────
+    for f in ("dimension_truth_report.json", "furniture_qa.json", "qa_mutation_report.json", "tests_report_historical_63.json"):
