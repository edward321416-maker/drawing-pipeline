+    assert r["max_identical_share"] <= furniture_qa.MAX_SHARE and r["n_types"] >= furniture_qa.MIN_TYPES
+    assert r["aisle_width_connecting_all_anchors_m"] is not None and r["aisle_width_connecting_all_anchors_m"] >= 1.2
+
+
