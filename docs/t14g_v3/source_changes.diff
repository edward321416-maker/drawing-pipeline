+
+def test_title_block_uses_config_not_hardcoded_text():
+    import t14d_sheet as T
+    from t14g import config
+    config.apply(T)
+    sh = T.Sheet("T-003", "t", 100, "DOCUMENT")
+    sh.title_block()
